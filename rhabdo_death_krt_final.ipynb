      "cell_type": "code",
      "source": [
        "# Model Calibration\n",
        "\n",
        "def calibration_plot(y_true, p_pred, n_bins=10, title=\"Calibration\"):\n",
        "    frac_pos, mean_pred = calibration_curve(\n",
        "        y_true, p_pred, n_bins=n_bins, strategy=\"quantile\"\n",
        "    )\n",
        "    brier = brier_score_loss(y_true, p_pred)\n",
        "\n",
        "    plt.figure()\n",
        "    plt.plot(mean_pred, frac_pos, marker=\"o\", label=f\"Model (Brier={brier:.3f})\")\n",
        "    plt.plot([0, 1], [0, 1], linestyle=\"--\", label=\"Perfect\")\n",
        "    plt.xlim(0, 1); plt.ylim(0, 1)\n",
        "    plt.xlabel(\"Mean predicted risk\")\n",
        "    plt.ylabel(\"Observed event rate\")\n",
        "    plt.title(title)\n",
        "    plt.grid(True, alpha=0.3)\n",
        "    plt.legend()\n",
        "    plt.show()\n",
        "\n",
        "def calibration_intercept_slope(y_true, p_pred):\n",
        "    eps = 1e-15\n",
        "    p = np.clip(p_pred, eps, 1-eps)\n",
        "    lp = logit(p)\n",
        "\n",
        "    X = sm.add_constant(lp)\n",
        "    model = sm.Logit(y_true, X).fit(disp=False)\n",
        "\n",
        "    intercept = model.params.iloc[0]\n",
        "    slope     = model.params.iloc[1]\n",
        "    ci        = model.conf_int()\n",
        "\n",
        "    intercept_ci = (ci.iloc[0, 0], ci.iloc[0, 1])\n",
        "    slope_ci     = (ci.iloc[1, 0], ci.iloc[1, 1])\n",
        "\n",
        "    return intercept, slope, intercept_ci, slope_ci\n",
        "\n",
        "# Internal test\n",
        "calibration_plot(y_test, test_prob, n_bins=10, title=\"Calibration – Internal test set (eICU)\")\n",
        "i_int, i_slope, i_int_ci, i_slope_ci = calibration_intercept_slope(y_test, test_prob)\n",
        "print(\"Internal test calibration:\")\n",
        "print(f\"  Intercept: {i_int:.3f} (CI {i_int_ci[0]:.3f} to {i_int_ci[1]:.3f})\")\n",
        "print(f\"  Slope:     {i_slope:.3f} (CI {i_slope_ci[0]:.3f} to {i_slope_ci[1]:.3f})\")\n",
        "\n",
        "# External validation\n",
        "calibration_plot(y__test,  val_prob,  n_bins=10, title=\"Calibration – External validation (MIMIC)\")\n",
        "v_int, v_slope, v_int_ci, v_slope_ci = calibration_intercept_slope(y__test, val_prob)\n",
        "print(\"External validation calibration:\")\n",
        "print(f\"  Intercept: {v_int:.3f} (CI {v_int_ci[0]:.3f} to {v_int_ci[1]:.3f})\")\n",
        "print(f\"  Slope:     {v_slope:.3f} (CI {v_slope_ci[0]:.3f} to {v_slope_ci[1]:.3f})\")"
      ],
