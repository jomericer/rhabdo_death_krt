    {
      "cell_type": "code",
      "source": [
        "def _to_1d(a):\n",
        "    return np.asarray(a).reshape(-1)\n",
        "\n",
        "def _check_binary(y, name=\"y\"):\n",
        "    y = _to_1d(y).astype(int)\n",
        "    u = np.unique(y)\n",
        "    if not set(u).issubset({0, 1}):\n",
        "        raise ValueError(f\"{name} must be binary 0/1. Found: {u}\")\n",
        "    return y\n",
        "\n",
        "def net_benefit(y_true, p_hat, thresholds):\n",
        "    y_true = _check_binary(y_true, \"y_true\")\n",
        "    p_hat = _to_1d(p_hat).astype(float)\n",
        "    if np.any(p_hat < 0) or np.any(p_hat > 1):\n",
        "        raise ValueError(\"Predicted probabilities must be in [0,1].\")\n",
        "\n",
        "    N = y_true.size\n",
        "    nb = np.zeros_like(thresholds, dtype=float)\n",
        "\n",
        "    for i, pt in enumerate(thresholds):\n",
        "        treat = (p_hat >= pt)\n",
        "        TP = np.sum(treat & (y_true == 1))\n",
        "        FP = np.sum(treat & (y_true == 0))\n",
        "        w = pt / (1 - pt)\n",
        "        nb[i] = (TP / N) - (FP / N) * w\n",
        "    return nb\n",
        "\n",
        "def net_benefit_treat_all(y_true, thresholds):\n",
        "    y_true = _check_binary(y_true, \"y_true\")\n",
        "    event_rate = np.mean(y_true)\n",
        "    nb_all = np.zeros_like(thresholds, dtype=float)\n",
        "    for i, pt in enumerate(thresholds):\n",
        "        w = pt / (1 - pt)\n",
        "        nb_all[i] = event_rate - (1 - event_rate) * w\n",
        "    return nb_all\n",
        "\n",
        "def net_benefit_treat_none(thresholds):\n",
        "    return np.zeros_like(thresholds, dtype=float)\n",
        "\n",
        "def bootstrap_nb_ci(y_true, p_hat, thresholds, B=1000, alpha=0.05, seed=123):\n",
        "    \"\"\"\n",
        "    Percentile bootstrap CI for net benefit at each threshold.\n",
        "    Returns: nb_point, nb_lo, nb_hi\n",
        "    \"\"\"\n",
        "    y_true = _check_binary(y_true, \"y_true\")\n",
        "    p_hat = _to_1d(p_hat).astype(float)\n",
        "    n = len(y_true)\n",
        "    rng = np.random.default_rng(seed)\n",
        "\n",
        "    nb_point = net_benefit(y_true, p_hat, thresholds)\n",
        "\n",
        "    boot = np.empty((B, len(thresholds)), dtype=float)\n",
        "    for b in range(B):\n",
        "        idx = rng.integers(0, n, size=n)  # sample with replacement\n",
        "        boot[b] = net_benefit(y_true[idx], p_hat[idx], thresholds)\n",
        "\n",
        "    lo = np.quantile(boot, alpha / 2, axis=0)\n",
        "    hi = np.quantile(boot, 1 - alpha / 2, axis=0)\n",
        "    return nb_point, lo, hi\n",
        "\n",
        "Xm = m1_df.loc[:,'mcmahon'].copy()\n",
        "ym = m1_df[outvar].copy().fillna(0)\n",
        "\n",
        "X__test_mcm = val.loc[:,'mcmahon'].copy()\n",
        "y__test_mcm = val[outvar].copy()\n",
        "\n",
        "X_train_mcm, X_test_mcm, y_train_mcm, y_test_mcm = train_test_split(Xm, ym, test_size=split, stratify=ym, random_state=RAND)\n",
        "\n",
        "X_train_mcm = X_train_mcm.to_frame(name=\"mcmahon\")\n",
        "X_test_mcm  = X_test_mcm.to_frame(name=\"mcmahon\")\n",
        "X__test_mcm = X__test_mcm.to_frame(name=\"mcmahon\")\n",
        "\n",
        "y_train_mcm = _check_binary(y_train_mcm, \"y_train_mcm\")\n",
        "y_int = _check_binary(y_test_mcm, \"y_test_mcm\")\n",
        "y_ext = _check_binary(y__test_mcm, \"y__test_mcm\")\n",
        "\n",
        "if len(test_prob_cal) != len(y_int):\n",
        "    raise ValueError(f\"Length mismatch: test_prob_cal ({len(test_prob_cal)}) vs y_test_mcm ({len(y_int)})\")\n",
        "if len(val_prob_cal) != len(y_ext):\n",
        "    raise ValueError(f\"Length mismatch: val_prob_cal ({len(val_prob_cal)}) vs y__test_mcm ({len(y_ext)})\")\n",
        "\n",
        "mcm_model = Pipeline([\n",
        "    (\"spline\", SplineTransformer(degree=3, n_knots=5, include_bias=False)),\n",
        "    (\"lr\", LogisticRegression(solver=\"lbfgs\", max_iter=1000))\n",
        "])\n",
        "\n",
        "mcm_model.fit(X_train_mcm, y_train_mcm)\n",
        "\n",
        "p_mcm_int = mcm_model.predict_proba(X_test_mcm)[:, 1]\n",
        "p_mcm_ext = mcm_model.predict_proba(X__test_mcm)[:, 1]\n",
        "\n",
        "thresholds = np.arange(0.05, 0.401, 0.01)  # 5% to 40%\n",
        "vlines = (0.10, 0.30)                      # clinically plausible band\n",
        "\n",
        "B = 1000\n",
        "alpha = 0.05\n",
        "seed = 123\n",
        "\n",
        "nb_ml_int,  nb_ml_int_lo,  nb_ml_int_hi  = bootstrap_nb_ci(y_int, test_prob_cal, thresholds, B=B, alpha=alpha, seed=seed)\n",
        "nb_mcm_int, nb_mcm_int_lo, nb_mcm_int_hi = bootstrap_nb_ci(y_int, p_mcm_int,     thresholds, B=B, alpha=alpha, seed=seed+1)\n",
        "\n",
        "nb_ml_ext,  nb_ml_ext_lo,  nb_ml_ext_hi  = bootstrap_nb_ci(y_ext, val_prob_cal, thresholds, B=B, alpha=alpha, seed=seed+2)\n",
        "nb_mcm_ext, nb_mcm_ext_lo, nb_mcm_ext_hi = bootstrap_nb_ci(y_ext, p_mcm_ext,     thresholds, B=B, alpha=alpha, seed=seed+3)\n",
        "\n",
        "nb_all_int = net_benefit_treat_all(y_int, thresholds)\n",
        "nb_all_ext = net_benefit_treat_all(y_ext, thresholds)\n",
        "nb_none    = net_benefit_treat_none(thresholds)\n",
        "\n",
        "plt.rcParams[\"figure.dpi\"] = 300\n",
        "fig, axes = plt.subplots(1, 2, figsize=(10, 4.5), sharey=True, dpi=300)\n",
        "\n",
        "ax = axes[0]\n",
        "ax.plot(thresholds, nb_ml_int, label=\"ML model (calibrated)\")\n",
        "ax.fill_between(thresholds, nb_ml_int_lo, nb_ml_int_hi, alpha=0.2)\n",
        "\n",
        "ax.plot(thresholds, nb_mcm_int, label=\"McMahon score (trained on derivation)\")\n",
        "ax.fill_between(thresholds, nb_mcm_int_lo, nb_mcm_int_hi, alpha=0.2)\n",
        "\n",
        "ax.plot(thresholds, nb_all_int, label=\"Treat all\", linestyle=\"--\")\n",
        "ax.plot(thresholds, nb_none,    label=\"Treat none\", linestyle=\":\")\n",
        "\n",
        "for x in vlines:\n",
        "    ax.axvline(x, linestyle=\":\", linewidth=1)\n",
        "\n",
        "ax.set_title(\"Internal validation\")\n",
        "ax.set_xlabel(\"Threshold probability\")\n",
        "ax.set_ylabel(\"Net benefit\")\n",
        "ax.legend(loc=\"best\")\n",
        "\n",
        "ax = axes[1]\n",
        "ax.plot(thresholds, nb_ml_ext, label=\"ML model (calibrated)\")\n",
        "ax.fill_between(thresholds, nb_ml_ext_lo, nb_ml_ext_hi, alpha=0.2)\n",
        "\n",
        "ax.plot(thresholds, nb_mcm_ext, label=\"McMahon score (trained on derivation)\")\n",
        "ax.fill_between(thresholds, nb_mcm_ext_lo, nb_mcm_ext_hi, alpha=0.2)\n",
        "\n",
        "ax.plot(thresholds, nb_all_ext, label=\"Treat all\", linestyle=\"--\")\n",
        "ax.plot(thresholds, nb_none,    label=\"Treat none\", linestyle=\":\")\n",
        "\n",
        "for x in vlines:\n",
        "    ax.axvline(x, linestyle=\":\", linewidth=1)\n",
        "\n",
        "ax.set_title(\"External validation\")\n",
        "ax.set_xlabel(\"Threshold probability\")\n",
        "ax.legend(loc=\"best\")\n",
        "\n",
        "fig.suptitle(\"Decision Curve Analysis (95% bootstrap CI): Composite of Death or Dialysis\")\n",
        "fig.tight_layout()\n",
        "plt.show()"
      ],
