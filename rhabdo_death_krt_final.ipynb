        "# Isotonic re-calibration\n",
        "def calibration_intercept_slope(y_true, p_pred):\n",
        "    eps = 1e-15\n",
        "    p = np.clip(np.asarray(p_pred), eps, 1 - eps)\n",
        "    y = np.asarray(y_true).astype(float)\n",
        "\n",
        "    lp = logit(p)\n",
        "    X = sm.add_constant(lp)\n",
        "\n",
        "    model = sm.Logit(y, X).fit(disp=False)\n",
        "\n",
        "    params = model.params\n",
        "    ci = model.conf_int()\n",
        "\n",
        "    if isinstance(params, np.ndarray):\n",
        "        intercept = params[0]\n",
        "        slope = params[1]\n",
        "        intercept_ci = (ci[0][0], ci[0][1])\n",
        "        slope_ci = (ci[1][0], ci[1][1])\n",
        "    else:\n",
        "        intercept = params.iloc[0]\n",
        "        slope = params.iloc[1]\n",
        "        intercept_ci = (ci.iloc[0, 0], ci.iloc[0, 1])\n",
        "        slope_ci = (ci.iloc[1, 0], ci.iloc[1, 1])\n",
        "\n",
        "    return intercept, slope, intercept_ci, slope_ci\n",
        "\n",
        "\n",
        "def plot_calibration(y_true, p_pred, n_bins=10, title=\"Calibration plot\"):\n",
        "    frac_pos, mean_pred = calibration_curve(\n",
        "        y_true, p_pred, n_bins=n_bins, strategy=\"quantile\"\n",
        "    )\n",
        "    brier = brier_score_loss(y_true, p_pred)\n",
        "\n",
        "    plt.figure()\n",
        "    plt.plot(mean_pred, frac_pos, marker=\"o\", linewidth=1, label=f\"Model (Brier={brier:.3f})\")\n",
        "    plt.plot([0, 1], [0, 1], linestyle=\"--\", label=\"Perfect calibration\")\n",
        "    plt.xlim(0, 1)\n",
        "    plt.ylim(0, 1)\n",
        "    plt.xlabel(\"Mean predicted risk\")\n",
        "    plt.ylabel(\"Observed event rate\")\n",
        "    plt.title(title)\n",
        "    plt.grid(True, alpha=0.3)\n",
        "    plt.legend()\n",
        "    plt.show()\n",
        "\n",
        "    return brier\n",
        "\n",
        "cal_rfc = CalibratedClassifierCV(rfc, method=\"isotonic\", cv=3)\n",
        "cal_rfc.fit(X_train, y_train)\n",
        "\n",
        "test_prob_cal = cal_rfc.predict_proba(X_test)[:, 1]\n",
        "val_prob_cal  = cal_rfc.predict_proba(X__test)[:, 1]  # y__test is your external labels\n",
        "\n",
        "# Internal test\n",
        "brier_test = plot_calibration(y_test, test_prob_cal, n_bins=10,\n",
        "                             title=\"Calibration – Internal test (Calibrated RF)\")\n",
        "i_int, i_slope, i_int_ci, i_slope_ci = calibration_intercept_slope(y_test, test_prob_cal)\n",
        "\n",
        "print(\"Internal test (calibrated RF):\")\n",
        "print(f\"  Brier:     {brier_test:.4f}\")\n",
        "print(f\"  Intercept: {i_int:.3f} (CI {i_int_ci[0]:.3f} to {i_int_ci[1]:.3f})\")\n",
        "print(f\"  Slope:     {i_slope:.3f} (CI {i_slope_ci[0]:.3f} to {i_slope_ci[1]:.3f})\")\n",
        "\n",
        "# External validation results\n",
        "brier_val = plot_calibration(y__test, val_prob_cal, n_bins=10,\n",
        "                            title=\"Calibration – External validation (Calibrated RF)\")\n",
        "v_int, v_slope, v_int_ci, v_slope_ci = calibration_intercept_slope(y__test, val_prob_cal)\n",
        "\n",
        "print(\"External validation (calibrated RF):\")\n",
        "print(f\"  Brier:     {brier_val:.4f}\")\n",
        "print(f\"  Intercept: {v_int:.3f} (CI {v_int_ci[0]:.3f} to {v_int_ci[1]:.3f})\")\n",
        "print(f\"  Slope:     {v_slope:.3f} (CI {v_slope_ci[0]:.3f} to {v_slope_ci[1]:.3f})\")"
