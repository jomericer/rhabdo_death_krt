        "def net_benefit_single(y_true, p_hat, pt):\n",
        "    y_true = np.asarray(y_true).astype(int)\n",
        "    p_hat = np.asarray(p_hat).astype(float)\n",
        "\n",
        "    N = len(y_true)\n",
        "    treat = (p_hat >= pt)\n",
        "\n",
        "    TP = np.sum(treat & (y_true == 1))\n",
        "    FP = np.sum(treat & (y_true == 0))\n",
        "\n",
        "    w = pt / (1 - pt)\n",
        "    nb = (TP / N) - (FP / N) * w\n",
        "    return nb\n",
        "\n",
        "thresholds = [0.10, 0.20, 0.30]\n",
        "\n",
        "rows = []\n",
        "\n",
        "for pt in thresholds:\n",
        "    # Internal\n",
        "    nb_ml_int  = net_benefit_single(y_int, test_prob_cal, pt)\n",
        "    nb_mcm_int = net_benefit_single(y_int, p_mcm_int, pt)\n",
        "    event_rate_int = np.mean(y_int)\n",
        "\n",
        "    # External\n",
        "    nb_ml_ext  = net_benefit_single(y_ext, val_prob_cal, pt)\n",
        "    nb_mcm_ext = net_benefit_single(y_ext, p_mcm_ext, pt)\n",
        "    event_rate_ext = np.mean(y_ext)\n",
        "\n",
        "    rows.append({\n",
        "        \"Threshold\": pt,\n",
        "\n",
        "        \"Internal_ML_NB\": nb_ml_int,\n",
        "        \"Internal_McMahon_NB\": nb_mcm_int,\n",
        "        \"Internal_Difference\": nb_ml_int - nb_mcm_int,\n",
        "        \"Internal_ML_sNB\": nb_ml_int / event_rate_int,\n",
        "        \"Internal_McMahon_sNB\": nb_mcm_int / event_rate_int,\n",
        "\n",
        "        \"External_ML_NB\": nb_ml_ext,\n",
        "        \"External_McMahon_NB\": nb_mcm_ext,\n",
        "        \"External_Difference\": nb_ml_ext - nb_mcm_ext,\n",
        "        \"External_ML_sNB\": nb_ml_ext / event_rate_ext,\n",
        "        \"External_McMahon_sNB\": nb_mcm_ext / event_rate_ext,\n",
        "    })\n",
        "\n",
        "df_dca_summary = pd.DataFrame(rows)\n",
        "\n",
        "pd.set_option(\"display.float_format\", lambda x: f\"{x:0.4f}\")\n",
        "df_dca_summary"
      ],
